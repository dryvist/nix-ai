{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>JacobPEvans/.github:renovate-nix",
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^mlx-server\\/pyproject\\.toml$/"],
      "matchStrings": [
        '# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) packageName=(?<packageName>\\S+) currentValue=(?<currentValue>\\S+) extractVersion=(?<extractVersion>\\S+)\\n\\s+"mlx-vlm @ https://github\\.com/Blaizzy/mlx-vlm/archive/(?<currentDigest>[a-f0-9]{40})\\.zip"',
      ],
    },
  ],
  "packageRules": [
    {
      "description": [
        "Exclude a transformers release that breaks mlx-lm during import; the",
        "release fails while registering a model and prevents worker startup.",
        "Remove the restriction after upstream fixes the registration behavior.",
      ],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["transformers"],
      "allowedVersions": "!/^5\\.13\\.0$/",
    },
    {
      "description": [
        "Keep huggingface-hub below the next major release while tokenizers",
        "requires the current major. Remove the hold when tokenizers supports",
        "the next major release.",
      ],
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["huggingface-hub"],
      "allowedVersions": "<2.0.0",
    },
    {
      "description": [
        "Hold the interpreter pin if Renovate annotations are added to",
        "lib/python.nix. Keep this hold scoped to that file so other pins and",
        "lockfile maintenance remain enabled.",
      ],
      "matchFileNames": ["lib/python.nix"],
      "enabled": false,
    },
  ],
}
