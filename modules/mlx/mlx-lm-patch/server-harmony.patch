+def _make_harmony_stream(cli_args):
+    """HarmonyStream for this completion, or None when disabled.
+
+    gpt-oss emits harmony channel markup that no chat template in this package
+    infers a tool parser for, so without this the markup lands verbatim in
+    `content` and `tool_calls` stays null. "auto" engages only when the turn
+    actually opens with harmony markup, so every other model is untouched.
+    """
+    mode = getattr(cli_args, "harmony_tool_parser", "auto")
+    return None if mode == "off" else _HarmonyStream(mode)
+
