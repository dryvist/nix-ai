+def _make_harmony_stream(cli_args, ctx):
+    """HarmonyStream for this completion, or None when harmony must stay out.
+
+    gpt-oss emits harmony channel markup that no chat template in this package
+    infers a tool parser for, so without this the markup lands verbatim in
+    `content` and `tool_calls` stays null.
+
+    Selection is gated here, not only inside HarmonyStream. "auto" engages only
+    when the model has no tool parser of its own — `ctx.tool_parser is None`,
+    which is exactly the condition that leaves harmony markup unhandled. A model
+    whose chat template does infer a parser (qwen3_coder, mistral, ...) keeps
+    that parser: harmony cannot read its dialect, so replacing it would make
+    every well-formed call raise and return an empty tool_calls array. A
+    harmony-family model that some future mlx-lm does infer a parser for is
+    served with "on", which is what the gpt-oss catalog entry pins.
+    """
+    mode = getattr(cli_args, "harmony_tool_parser", "auto")
+    if mode == "off":
+        return None
+    if mode == "auto" and getattr(ctx, "tool_parser", None) is not None:
+        return None
+    return _HarmonyStream(mode)
+
+
+def _select_tool_parser(harmony_stream, ctx):
+    """The parse function ToolCallFormatter must use for this completion.
+
+    It has to agree with whatever filled `tool_calls`: harmony segments when
+    HarmonyStream is running, the model's own state-machine captures otherwise.
+    Mismatch is silent — the parser raises on every call and the formatter
+    returns an empty list.
+    """
+    return _harmony_parse_tool_call if harmony_stream is not None else ctx.tool_parser
+
