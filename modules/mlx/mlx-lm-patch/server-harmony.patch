+class _LoudToolCallFormatter(ToolCallFormatter):
+    """ToolCallFormatter that never silently drops a tool call.
+
+    Upstream logs a warning and skips a tool call whose parse raised. Because
+    `generate_response` omits `tool_calls` when the list is empty, a turn where
+    every call failed reaches the client with no tool calls and no content —
+    indistinguishable from a turn the model never made. Keep the unparsed text
+    so the caller can hand it back as content, and count what actually went out
+    so `finish_reason` cannot claim "tool_calls" with none attached.
+    """
+
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        self.emitted = 0
+        self._unparsed = []
+
+    def __call__(self, tool_calls):
+        result = []
+        for tool_text in tool_calls or []:
+            try:
+                parsed = self._tool_parser(tool_text, self._tools)
+            except (ValueError, json.JSONDecodeError) as e:
+                logging.error(
+                    f"Failed to parse tool call ({type(e).__name__}: {e}) — "
+                    f"returning it as content rather than dropping it."
+                )
+                self._unparsed.append(tool_text)
+                continue
+            if not isinstance(parsed, list):
+                parsed = [parsed]
+            result.extend(self._format(tc) for tc in parsed)
+        self.emitted += len(result)
+        return result
+
+    def drain_unparsed(self) -> str:
+        """Text of every tool call that failed to parse since the last drain."""
+        out, self._unparsed = "".join(self._unparsed), []
+        return out
+
