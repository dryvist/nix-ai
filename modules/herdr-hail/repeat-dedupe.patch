diff --git a/src/repeat.test.ts b/src/repeat.test.ts
new file mode 100644
index 0000000..80bf9d7
--- /dev/null
+++ b/src/repeat.test.ts
@@ -0,0 +1,128 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import type { Agent, AgentStatus, HerdrClient } from "./herdr.js";
+import { RepeatGuard } from "./repeat.js";
+import { Watcher } from "./watcher.js";
+
+const agent = (status: string): Agent =>
+  ({
+    terminal_id: "t1",
+    agent: "claude",
+    terminal_title: "t",
+    terminal_title_stripped: "t",
+    agent_status: status,
+    workspace_id: "w1",
+    tab_id: "tab",
+    pane_id: "w1:p1",
+    focused: false,
+    cwd: "/work",
+    foreground_cwd: "/work",
+    revision: 1,
+  }) as Agent;
+
+/** Feed a transition through the same delivery gate used by index.ts. */
+const feed = async (
+  guard: RepeatGuard,
+  posts: { status: AgentStatus; context: string }[],
+  id: string,
+  to: AgentStatus,
+  context: string,
+): Promise<void> => {
+  await guard.notifyOnce(id, to, async () => {
+    if (!["blocked", "done"].includes(to)) return false;
+    posts.push({ status: to, context });
+    return true;
+  });
+};
+
+test("ten reports of the same blocked state with changing context notify exactly once", async () => {
+  const guard = new RepeatGuard();
+  const posts: { status: AgentStatus; context: string }[] = [];
+  for (let tick = 0; tick < 10; tick++) {
+    await feed(guard, posts, "t1", "blocked", `context ${tick}`);
+  }
+  assert.equal(posts.length, 1);
+  assert.deepEqual(posts[0], { status: "blocked", context: "context 0" });
+});
+
+test("leaving blocked and re-entering notifies a second time", async () => {
+  const guard = new RepeatGuard();
+  const posts: { status: AgentStatus; context: string }[] = [];
+  await feed(guard, posts, "t1", "blocked", "first context");
+  await feed(guard, posts, "t1", "blocked", "same episode");
+  await feed(guard, posts, "t1", "working", "not notified");
+  await feed(guard, posts, "t1", "blocked", "new episode");
+  assert.equal(posts.length, 2);
+  assert.deepEqual(posts.map((post) => post.status), ["blocked", "blocked"]);
+});
+
+test("failed delivery leaves the blocked episode eligible for retry", async () => {
+  const guard = new RepeatGuard();
+  let attempts = 0;
+  let posts = 0;
+  const deliver = () =>
+    guard.notifyOnce("t1", "blocked", async () => {
+      attempts++;
+      if (attempts === 1) return false;
+      posts++;
+      return true;
+    });
+
+  assert.equal(await deliver(), false);
+  assert.equal(await deliver(), true);
+  assert.equal(await deliver(), false);
+  assert.equal(attempts, 2);
+  assert.equal(posts, 1);
+});
+
+test("agents in different terminals hold independent latches", async () => {
+  const guard = new RepeatGuard();
+  const posts: { status: AgentStatus; context: string }[] = [];
+  await feed(guard, posts, "t1", "blocked", "first terminal");
+  await feed(guard, posts, "t2", "blocked", "second terminal");
+  await feed(guard, posts, "t1", "blocked", "repeat");
+  assert.equal(posts.length, 2);
+});
+
+test("the repeat latch evicts the oldest terminal when full", async () => {
+  const guard = new RepeatGuard();
+  for (let terminal = 0; terminal < 1025; terminal++) {
+    await guard.notifyOnce(`t${terminal}`, "blocked", async () => true);
+  }
+  assert.equal(await guard.notifyOnce("t0", "blocked", async () => true), true);
+});
+
+test("a held blocked state posts once across ten ticks; re-entry posts again", async () => {
+  let status = "working";
+  const herdr = {
+    request: async () => ({}),
+    agentList: async () => [agent(status)],
+    agentRead: async () => "",
+    agentSend: async () => {},
+    ping: async () => true,
+  } as unknown as HerdrClient;
+  const watcher = new Watcher(herdr, 1500);
+  const guard = new RepeatGuard();
+  const posts: { status: AgentStatus; context: string }[] = [];
+  const pending: Promise<void>[] = [];
+  watcher.on("transition", (t) => {
+    pending.push(feed(guard, posts, t.agent.terminal_id, t.to, t.to));
+  });
+
+  const poll = async () => {
+    await (watcher as unknown as { poll(): Promise<void> }).poll();
+    await Promise.all(pending.splice(0));
+  };
+  await poll(); // primes without emitting
+  status = "blocked";
+  for (let tick = 0; tick < 10; tick++) await poll();
+  assert.equal(posts.length, 1);
+  assert.deepEqual(posts.map((post) => post.status), ["blocked"]);
+
+  status = "working";
+  await poll();
+  status = "blocked";
+  await poll();
+  assert.equal(posts.length, 2);
+  assert.deepEqual(posts.map((post) => post.status), ["blocked", "blocked"]);
+});
diff --git a/src/repeat.ts b/src/repeat.ts
new file mode 100644
index 0000000..10595a0
--- /dev/null
+++ b/src/repeat.ts
@@ -0,0 +1,53 @@
+import type { AgentStatus } from "./herdr.js";
+
+const MAX_NOTIFIED_TERMINALS = 1024;
+
+/**
+ * One notification per status stay: a transition into a status notifies,
+ * further transitions into the same held status notify nothing, and a
+ * transition into any other status re-arms the agent so re-entering notifies
+ * again.
+ *
+ * Keyed by terminal_id and status only — never by notification content. An
+ * earlier guard keyed on the pane excerpt, which keeps changing while the
+ * agent waits (clocks, counters, redraws), so every repeat looked new and one
+ * waiting agent was hailed every few minutes. Restarting the bridge resets
+ * this guard, but the watcher stays quiet while a status is unchanged, so a
+ * restart alone never re-posts.
+ */
+export class RepeatGuard {
+  private notified = new Map<string, AgentStatus>(); // terminal_id -> status posted for
+
+  /**
+   * Whether a transition into `to` may notify. Seeing any status other than
+   * the one last posted for clears the latch: the agent left the state it was
+   * notified for, so entering again notifies again.
+   */
+  mayNotify(terminalId: string, to: AgentStatus): boolean {
+    const latched = this.notified.get(terminalId);
+    if (latched === to) return false;
+    this.notified.delete(terminalId);
+    return true;
+  }
+
+  /** Run a delivery for an eligible state and latch it only after success. */
+  async notifyOnce(
+    terminalId: string,
+    status: AgentStatus,
+    deliver: () => Promise<boolean>,
+  ): Promise<boolean> {
+    if (!this.mayNotify(terminalId, status)) return false;
+    if (!(await deliver())) return false;
+    this.markNotified(terminalId, status);
+    return true;
+  }
+
+  /** Record that `terminalId` was notified while holding `status`. */
+  markNotified(terminalId: string, status: AgentStatus): void {
+    this.notified.set(terminalId, status);
+    if (this.notified.size > MAX_NOTIFIED_TERMINALS) {
+      const oldest = this.notified.keys().next();
+      if (!oldest.done) this.notified.delete(oldest.value);
+    }
+  }
+}
