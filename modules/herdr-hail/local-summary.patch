diff --git a/src/notification.test.ts b/src/notification.test.ts
new file mode 100644
index 0000000..732fdd9
--- /dev/null
+++ b/src/notification.test.ts
@@ -0,0 +1,162 @@
+import assert from "node:assert/strict";
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { test } from "node:test";
+import type { Config } from "./config.js";
+import { loadConfig } from "./config.js";
+import { parseMenu } from "./menu.js";
+import { buildNotification, cleanContext, summarizeContext, summaryLines } from "./notification.js";
+
+const summarizer: Config["summarizer"] = {
+  enabled: true,
+  baseUrl: "http://127.0.0.1:11434/v1",
+  model: "fast",
+  timeoutMs: 1500,
+  maxInputChars: 4000,
+};
+
+function beforeSummaryPatchBuilder(
+  agent: Parameters<typeof buildNotification>[0],
+  context: string,
+  contextLines: number,
+): ReturnType<typeof buildNotification> {
+  const choices = agent.agent_status === "blocked" ? parseMenu(context) : null;
+  return {
+    paneId: agent.pane_id,
+    status: agent.agent_status,
+    title: agent.terminal_title_stripped || agent.terminal_title || agent.pane_id,
+    cwd: agent.cwd,
+    agentKind: agent.agent,
+    context: context
+      .split("\n")
+      .filter((line) => !/^\s*[❯>›▶]?\s*\d{1,2}[.)]\s+chat about this\s*$/iu.test(line))
+      .join("\n")
+      .trim(),
+    contextLines,
+    choices: choices?.filter((choice) => !/^chat about this$/i.test(choice.label)) ?? null,
+  };
+}
+
+test("cleanContext strips terminal decoration but preserves question text and links", () => {
+  assert.equal(
+    cleanContext("\u001b[31m╭────────╮\u001b[0m\n│  Allow this?  https://example.test/a  │\n✻ Thinking…\n╰────────╯"),
+    "Allow this? https://example.test/a",
+  );
+});
+
+test("disabled summary output matches the pre-summary builder byte-for-byte", async () => {
+  const agent = {
+    pane_id: "w1:p1",
+    agent_status: "blocked",
+    terminal_title_stripped: "Approval",
+    terminal_title: "",
+    cwd: "/work",
+    agent: "claude",
+  } as Parameters<typeof buildNotification>[0];
+  const context =
+    "╭──────────────╮\n✻ Thinking…  \n  *Question* _keep_ ~literal~  \n❯ 1. Allow once\n  2. Chat about this\n╰──────────────╯";
+  const request: typeof fetch = async () => {
+    throw new Error("disabled summarizer must not fetch");
+  };
+  assert.equal(await summarizeContext(context, { ...summarizer, enabled: false }, request), "");
+
+  const expected = beforeSummaryPatchBuilder(agent, context, 40);
+  const notification = buildNotification(agent, context, 40);
+
+  assert.deepEqual(notification, expected);
+  assert.deepEqual(Buffer.from(notification.context), Buffer.from(expected.context));
+  assert.deepEqual(summaryLines(notification), [
+    "🔴 *claude* needs your input",
+    "*Approval*",
+    "`/work`",
+    "```╭──────────────╮\n✻ Thinking…  \n  *Question* _keep_ ~literal~  \n❯ 1. Allow once\n╰──────────────╯```",
+    "_Tap a choice below (or reply in-thread to type an answer)._",
+  ]);
+});
+
+test("summary appears before the unchanged question and menu choices", () => {
+  const context = "Can the agent run this command?\n❯ 1. Allow once\n  2. Deny\nhttps://example.test/a";
+  const notification = buildNotification(
+    {
+      pane_id: "w1:p1",
+      agent_status: "blocked",
+      terminal_title_stripped: "Approval",
+      terminal_title: "",
+      cwd: "/work",
+      agent: "claude",
+    } as Parameters<typeof buildNotification>[0],
+    context,
+    40,
+  );
+  const summary = "The agent is waiting for permission to run a command.";
+  notification.summary = summary;
+  const lines = summaryLines(notification).join("\n");
+
+  assert.ok(lines.indexOf(summary) < lines.indexOf("Can the agent run this command?"));
+  assert.equal(notification.context, context);
+  assert.ok(lines.includes(`\`\`\`${context}\`\`\``));
+  assert.deepEqual(notification.choices?.map(({ number, label }) => [number, label]), [
+    ["1", "Allow once"],
+    ["2", "Deny"],
+  ]);
+});
+
+test("summarizer sends only the recent bounded context to loopback", async () => {
+  let body = "";
+  const request: typeof fetch = async (input, init) => {
+    assert.equal(String(input), "http://127.0.0.1:11434/v1/chat/completions");
+    body = String(init?.body);
+    return new Response(JSON.stringify({ choices: [{ message: { content: "Needs approval." } }] }));
+  };
+  const summary = await summarizeContext(`${"x".repeat(4001)}question`, summarizer, request);
+  const userMessage = JSON.parse(body).messages[1].content as string;
+
+  assert.equal(summary, "Needs approval.");
+  assert.equal(userMessage.length, "Recent terminal output:\n".length + 4000);
+  assert.ok(userMessage.endsWith("question"));
+});
+
+test("summarizer refuses redirects without following them", async () => {
+  let redirect: RequestRedirect | undefined;
+  const request: typeof fetch = async (_input, init) => {
+    redirect = init?.redirect;
+    return new Response(null, {
+      status: 307,
+      headers: { location: "https://example.test/collect" },
+    });
+  };
+
+  assert.equal(await summarizeContext("private terminal output", summarizer, request), "");
+  assert.equal(redirect, "error");
+});
+
+test("summarizer never sends pane output to a non-loopback endpoint", async () => {
+  let called = false;
+  const request: typeof fetch = async () => {
+    called = true;
+    return new Response("{}", { status: 200 });
+  };
+  assert.equal(
+    await summarizeContext("private terminal output", { ...summarizer, baseUrl: "https://example.test/v1" }, request),
+    "",
+  );
+  assert.equal(called, false);
+});
+
+test("loadConfig rejects a non-loopback summarizer baseUrl", () => {
+  const dir = fs.mkdtempSync(path.join(os.tmpdir(), "herdr-hail-config-"));
+  const previous = process.env.HERDR_PLUGIN_CONFIG_DIR;
+  try {
+    fs.writeFileSync(
+      path.join(dir, "config.json"),
+      JSON.stringify({ summarizer: { baseUrl: "https://example.test/v1" } }),
+    );
+    process.env.HERDR_PLUGIN_CONFIG_DIR = dir;
+    assert.throws(() => loadConfig(), /loopback/);
+  } finally {
+    if (previous === undefined) delete process.env.HERDR_PLUGIN_CONFIG_DIR;
+    else process.env.HERDR_PLUGIN_CONFIG_DIR = previous;
+    fs.rmSync(dir, { recursive: true, force: true });
+  }
+});
