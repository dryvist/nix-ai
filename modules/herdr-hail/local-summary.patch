diff --git a/src/notification.test.ts b/src/notification.test.ts
new file mode 100644
index 0000000..732fdd9
--- /dev/null
+++ b/src/notification.test.ts
@@ -0,0 +1,75 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import type { Config } from "./config.js";
+import { buildNotification, cleanContext, summarizeContext, summaryLines } from "./notification.js";
+
+const summarizer: Config["summarizer"] = {
+  enabled: true,
+  baseUrl: "http://127.0.0.1:11434/v1",
+  model: "fast",
+  timeoutMs: 1500,
+  maxInputChars: 4000,
+};
+
+test("cleanContext strips terminal decoration but preserves question text and links", () => {
+  assert.equal(
+    cleanContext("\u001b[31m╭────────╮\u001b[0m\n│  Allow this?  https://example.test/a  │\n✻ Thinking…\n╰────────╯"),
+    "Allow this? https://example.test/a",
+  );
+});
+
+test("summary appears before the unchanged question and menu choices", () => {
+  const context = "Can the agent run this command?\n❯ 1. Allow once\n  2. Deny\nhttps://example.test/a";
+  const notification = buildNotification(
+    {
+      pane_id: "w1:p1",
+      agent_status: "blocked",
+      terminal_title_stripped: "Approval",
+      terminal_title: "",
+      cwd: "/work",
+      agent: "claude",
+    } as Parameters<typeof buildNotification>[0],
+    context,
+    40,
+  );
+  const summary = "The agent is waiting for permission to run a command.";
+  notification.summary = summary;
+  const lines = summaryLines(notification).join("\n");
+  const cleaned = "Can the agent run this command?\n❯ 1. Allow once\n2. Deny\nhttps://example.test/a";
+
+  assert.ok(lines.indexOf(summary) < lines.indexOf("Can the agent run this command?"));
+  assert.equal(notification.context, cleaned);
+  assert.ok(lines.includes(cleaned));
+  assert.deepEqual(notification.choices?.map(({ number, label }) => [number, label]), [
+    ["1", "Allow once"],
+    ["2", "Deny"],
+  ]);
+});
+
+test("summarizer sends only the recent bounded context to loopback", async () => {
+  let body = "";
+  const request: typeof fetch = async (input, init) => {
+    assert.equal(String(input), "http://127.0.0.1:11434/v1/chat/completions");
+    body = String(init?.body);
+    return new Response(JSON.stringify({ choices: [{ message: { content: "Needs approval." } }] }));
+  };
+  const summary = await summarizeContext(`${"x".repeat(4001)}question`, summarizer, request);
+  const userMessage = JSON.parse(body).messages[1].content as string;
+
+  assert.equal(summary, "Needs approval.");
+  assert.equal(userMessage.length, "Recent terminal output:\n".length + 4000);
+  assert.ok(userMessage.endsWith("question"));
+});
+
+test("summarizer never sends pane output to a non-loopback endpoint", async () => {
+  let called = false;
+  const request: typeof fetch = async () => {
+    called = true;
+    return new Response("{}", { status: 200 });
+  };
+  assert.equal(
+    await summarizeContext("private terminal output", { ...summarizer, baseUrl: "https://example.test/v1" }, request),
+    "",
+  );
+  assert.equal(called, false);
+});
