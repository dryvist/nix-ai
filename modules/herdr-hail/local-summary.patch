+export function isLoopbackBaseUrl(baseUrl: string): boolean {
+  try {
+    const endpoint = new URL(baseUrl);
+    return (
+      ["localhost", "127.0.0.1", "[::1]", "::1"].includes(endpoint.hostname) &&
+      ["http:", "https:"].includes(endpoint.protocol) &&
+      !endpoint.username &&
+      !endpoint.password &&
+      !endpoint.search &&
+      !endpoint.hash
+    );
+  } catch {
+    return false;
+  }
+}
