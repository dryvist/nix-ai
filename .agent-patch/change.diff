diff --git a/.github/workflows/post-merge.yml b/.github/workflows/post-merge.yml
new file mode 100644
index 00000000..d361bc24
--- /dev/null
+++ b/.github/workflows/post-merge.yml
@@ -0,0 +1,43 @@
+# Post Merge — develop pushes settle what the merge queue deferred.
+#
+# Thin wrapper over the shared post-merge workflow. The gate no longer runs
+# on push (ci-gate.yml), so this takes over the develop pushes: it re-runs
+# the CI Gate on HEAD over the commits the `green` ref has not settled,
+# fast-forwards green, and reverts deferred pull requests that went red.
+# The push-event gate run also saves the Nix store cache pull requests
+# restore.
+#
+name: Post Merge
+
+on:
+  push:
+    branches: [develop]
+
+jobs:
+  post-merge:
+    permissions:
+      contents: write    # green ref moves, post-merge-red dispatches
+      pull-requests: write
+      checks: read       # AI Merge Gate verdicts on the head commits
+      actions: read      # the gate's run report reads this run's jobs
+    uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+    with:
+      # The caller's gate stack, forwarded verbatim.
+      profile: nix
+      filters: |
+        nix:
+          - '.github/workflows/ci-gate.yml'
+          - '**.nix'
+          - 'flake.lock'
+          - 'lib/**'
+          - 'modules/**'
+          - 'scripts/**'
+        markdown:
+          - '**.md'
+          - '.markdownlint*'
+        python:
+          - 'mlx-server/**'
+          - 'orchestrator/**'
+    secrets:
+      GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+      slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
